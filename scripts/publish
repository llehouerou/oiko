#!/usr/bin/env bash
# Publishes the release vX.Y.Z that scripts/release tagged: pushes the tag,
# creates its GitHub Release with notes.md as its notes, posts them under
# Discussions → Announcements (CONTRIBUTING.md), and has the Go module proxy
# fetch the version, which pkg.go.dev then indexes. The notes take the previous
# release's shape: `gh release view` shows it.
set -euo pipefail

version=${1:-} notes=${2:-}
if [[ ! $version =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ || ! -f $notes ]]; then
	echo "usage: scripts/publish vX.Y.Z notes.md" >&2
	exit 2
fi
cd "$(git rev-parse --show-toplevel)"
if ! git rev-parse -q --verify "refs/tags/$version" >/dev/null; then
	echo "publish: no tag $version: run scripts/release $version first" >&2
	exit 1
fi
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
module=$(git show "$version:go.mod" | sed -n 's/^module //p')

git push origin "$version"
url=$(gh release create "$version" --verify-tag --title "$version" --notes-file "$notes")
echo "released: $url"

ids=$(gh api graphql \
	-f query='query($o: String!, $n: String!) { repository(owner: $o, name: $n) { id discussionCategory(slug: "announcements") { id } } }' \
	-f o="${repo%/*}" -f n="${repo#*/}" \
	--jq '.data.repository | "\(.id) \(.discussionCategory.id)"')
read -r repo_id category_id <<<"$ids"
announcement=$(gh api graphql \
	-f query='mutation($r: ID!, $c: ID!, $t: String!, $b: String!) { createDiscussion(input: {repositoryId: $r, categoryId: $c, title: $t, body: $b}) { discussion { url } } }' \
	-f r="$repo_id" -f c="$category_id" -f t="Oiko $version" -f b="$url"$'\n\n'"$(<"$notes")" \
	--jq .data.createDiscussion.discussion.url)
echo "announced: $announcement"

curl -fsS "https://proxy.golang.org/$module/@v/$version.info" >/dev/null
echo "proxied: https://pkg.go.dev/$module@$version"
