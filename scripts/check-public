#!/usr/bin/env bash
# Fails on personal data this public repo must not carry (AGENTS.md): a home
# directory, a private IPv4 or a MAC address, a real-looking IEEE address, an
# email outside the reserved example domains.
#
#   scripts/check-public            what is staged (the pre-commit hook, CI)
#   scripts/check-public <file>...  those files (the commit-msg hook)
#
# A match listed in scripts/check-public.allow, one per line, passes. What a
# release commit adds, web/dist and THIRD_PARTY_NOTICES.md, is not searched: it
# is third-party code and license texts, their authors' emails included.
# ponytail: a pattern list, not a scanner: names, host names and coordinates of
# a real home still need a human eye.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

files=("$@")
search() {
	if ((${#files[@]})); then
		grep -HonP -- "$1" "${files[@]}" || true
	else
		git grep --cached -IonP -- "$1" -- . ':!scripts/check-public*' ':!go.sum' ':!web/package-lock.json' \
			':!web/dist' ':!THIRD_PARTY_NOTICES.md' || true
	fi
}

found=$(
	search '/(home|Users)/[^/\s]+/'
	search '\b(10(\.\d{1,3}){3}|192\.168(\.\d{1,3}){2}|172\.(1[6-9]|2\d|3[01])(\.\d{1,3}){2})\b'
	search '\b([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\b'
	# A made-up IEEE address is a vendor prefix followed by zeros: 0x00158d0000000004.
	search '\b0x[0-9A-Fa-f]{16}\b' | grep -vP '0x[0-9A-Fa-f]{6}[0-9A-Fa-f]*0{6}' || true
	search '[\w.%+-]+@[\w-]+(\.[\w-]+)*\.[a-z]{2,}\b' |
		grep -vP '@(example\.(org|com|net)|[\w.-]+\.(example|test|invalid))\b' || true
)
found=$(grep -vFf <(grep -v '^#' scripts/check-public.allow) <<<"$found" || true)

if [[ -n $found ]]; then
	echo "$found"
	echo 'check-public: personal data above (AGENTS.md); replace it with made-up data, or list a made-up match in scripts/check-public.allow'
	exit 1
fi
