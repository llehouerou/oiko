#!/usr/bin/env bash
# Releases Oiko as version vX.Y.Z (ADR 0018): tags a commit, child of HEAD and
# on no branch, that adds the built web client, so that the module the Go
# proxy serves embeds it, stamps the version in internal/build/release.go,
# for builds where Go records none (Nix), and adds THIRD_PARTY_NOTICES.md from
# scripts/notices (ADR 0047). Before anything else, gorelease
# compares the exported API with the previous release and refuses a version
# those changes do not allow (ADR 0019): during v0, a patch that breaks or adds
# anything. Run from the dev shell; scripts/publish publishes the tag.
set -euo pipefail

version=${1:-}
if [[ ! $version =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
	echo "usage: scripts/release vX.Y.Z" >&2
	exit 2
fi
cd "$(git rev-parse --show-toplevel)"
if [[ -n $(git status --porcelain) ]]; then
	echo "release: commit or stash your changes first" >&2
	exit 1
fi

# Release tags are not ancestors of HEAD (ADR 0018): the previous release is
# the highest tag, compared under its own module path so that a major release,
# which changes the path, is not held to the old one's API.
gorelease() {
	GOPRIVATE=github.com/llehouerou/oiko go run golang.org/x/exp/cmd/gorelease@v0.0.0-20260908205506-85c1c2202aba "$@"
}
previous=$(git tag --list 'v*' --sort=-v:refname | head -n1)
base=none
if [[ -n $previous ]]; then
	if [[ $previous == "$version" ]] || ! printf '%s\n' "$previous" "$version" | sort -V -C; then
		echo "release: $version is not higher than the previous release $previous" >&2
		exit 1
	fi
	base=$(git show "$previous:go.mod" | sed -n 's/^module //p')@$previous
fi
report=$(gorelease -base="$base" 2>&1) || true
echo "$report"
# gorelease lets anything through during v0, where a patch still neither
# breaks nor adds (ADR 0019).
if [[ $previous == v0.* && ${version%.*} == "${previous%.*}" ]] && grep -qE '^## (in)?compatible changes$' <<<"$report"; then
	echo "release: the API changed since $previous, which a patch may not do: release a minor" >&2
	exit 1
fi
if ! verdict=$(gorelease -base="$base" -version="$version" 2>&1); then
	echo "$verdict" >&2
	echo "release: gorelease refuses $version" >&2
	exit 1
fi

make test
nix build --no-link # the flake's package lists its sources: a new root file must be in it
(cd web && npm run build)
notices=$(scripts/notices)

stamp=internal/build/release.go
stamped=$(sed "s/^const release = \"\"\$/const release = \"$version\"/" "$stamp")
if [[ $stamped != *"const release = \"$version\""* ]]; then
	echo "release: $stamp has no line const release = \"\"" >&2
	exit 1
fi

index=$(mktemp)
trap 'rm -f "$index"' EXIT
GIT_INDEX_FILE=$index git read-tree HEAD
GIT_INDEX_FILE=$index git add -f web/dist
GIT_INDEX_FILE=$index git update-index --cacheinfo "100644,$(git hash-object -w --stdin <<<"$stamped"),$stamp"
GIT_INDEX_FILE=$index git update-index --add --cacheinfo "100644,$(git hash-object -w --stdin <<<"$notices"),THIRD_PARTY_NOTICES.md"
tree=$(GIT_INDEX_FILE=$index git write-tree)
commit=$(git commit-tree "$tree" -p HEAD -m "Release $version, with the built web client, its version and the third-party notices")
git tag -a "$version" "$commit" -m "Oiko $version"
echo "tagged $version ($commit)"
if [[ -n $previous ]]; then
	echo "since $previous:"
	git log --format='  %h %s' "$(git merge-base "$previous" HEAD)..HEAD"
fi
echo "write its notes in the shape of $previous's (gh release view $previous), then: scripts/publish $version notes.md"
