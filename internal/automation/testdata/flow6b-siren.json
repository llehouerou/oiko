{
  "name": "Siren auto-reset",
  "enabled": true,
  "steps": [
    {"id": "ringing", "kind": "valueTrigger", "name": "Siren on for 5 min", "params": {"target": "device:alarm/alarm", "capability": "alarm", "op": "eq", "value": true, "heldFor": 300}},
